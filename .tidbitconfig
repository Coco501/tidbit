# User Options
editor=vim
file_extension=md

# fzf Options
fzf_opts=(
  --exact # for exact matches only
  --border=rounded
  --padding=5%
  --prompt="tidbit "
  --pointer='>o' # it's a lil fish :3
  --color=fg:#8fb6e3
  --color=bg:#30343b
  --color=preview-fg:#FFF3DE
  --color=preview-bg:#30343b
  --color=hl:#5acff2
  --color=hl+:#5acff2
  --color=fg+:#FFBE2C
  --color=bg+:#30343b
  --color=gutter:#30343b
  --color=pointer:#FFBE2C
  --color=query:#FFBE2C
  --color=disabled:
  --color=info:
  --color=border:#FFBE2C
  --color=prompt:#7ba3d1
  --color=label:#7ba3d1
  --color=marker:
  --color=header:
  --color=spinner:
  # WARNING: border label options only work with fzf 35.0 and newer
  --border-label=tidbit
  --border-label-pos=2
  --bind='ctrl-u:preview-half-page-up'
  --bind='ctrl-d:preview-half-page-down'
)

